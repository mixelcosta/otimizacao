<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareOptimizer.App.ViewModels"
             x:Class="HardwareOptimizer.App.Views.OtimizadorWindowsView"
             x:DataType="vm:OtimizadorWindowsViewModel">

  <UserControl.Styles>

    <!-- Botões de seleção rápida (Tudo / Nenhum) -->
    <Style Selector="Button.sel-rapida">
      <Setter Property="Background"   Value="#1A1A1A" />
      <Setter Property="Foreground"   Value="#666666" />
      <Setter Property="FontSize"     Value="11" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding"      Value="10,4" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.sel-rapida:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#252525" />
    </Style>

    <!-- Checkbox dos efeitos visuais -->
    <Style Selector="CheckBox.efeito">
      <Setter Property="Foreground" Value="#AAAAAA" />
      <Setter Property="FontSize"   Value="12" />
    </Style>
    <Style Selector="CheckBox.efeito:checked /template/ Border#NormalRectangle">
      <Setter Property="Background"   Value="#00C870" />
      <Setter Property="BorderBrush"  Value="#00C870" />
    </Style>
    <Style Selector="CheckBox.efeito:checked">
      <Setter Property="Foreground" Value="#CCCCCC" />
    </Style>
    <Style Selector="CheckBox.efeito:unchecked">
      <Setter Property="Foreground" Value="#555555" />
    </Style>

  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="16">

      <TextBlock Text="OTIMIZADOR WINDOWS" FontSize="13" FontWeight="Bold"
                 Foreground="#444444" LetterSpacing="3" />

      <!-- ── Efeitos Visuais ──────────────────────────────────────────────── -->
      <Border Background="#111111" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">

          <!-- Cabeçalho + badge "aplicado" -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Efeitos Visuais" Foreground="#CCCCCC" FontWeight="SemiBold" />
              <TextBlock Foreground="#555555" FontSize="11" Margin="0,2,0,0"
                         Text="VisualFXSetting → Melhor Desempenho (registro HKCU)" />
            </StackPanel>
            <Border Grid.Column="1" Background="#0D2A1A" CornerRadius="4"
                    Padding="8,4" VerticalAlignment="Center"
                    IsVisible="{Binding EfeitosVisuaisDesativados}">
              <TextBlock Text="✓ aplicado" Foreground="#00FF88" FontSize="11" />
            </Border>
          </Grid>

          <!-- Seleção rápida -->
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
            <TextBlock Text="SELECIONAR:" Foreground="#383838" FontSize="10"
                       FontWeight="Bold" LetterSpacing="2" VerticalAlignment="Center" />
            <Button Classes="sel-rapida"
                    Content="Tudo"
                    Command="{Binding SelecionarTudoCommand}" />
            <Button Classes="sel-rapida"
                    Content="Nenhum"
                    Command="{Binding LimparSelecaoCommand}" />
          </StackPanel>

          <!-- Lista de efeitos com checkboxes -->
          <ItemsControl ItemsSource="{Binding EfeitosVisuais}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EfeitoVisualViewModel">
                <Border Background="#0D0D0D" CornerRadius="5"
                        Padding="12,9" Margin="0,2">
                  <CheckBox Classes="efeito"
                             IsChecked="{Binding Selecionado}"
                             Content="{Binding Nome}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Botão de confirmação -->
          <Button Content="Confirmar e desativar selecionados"
                  Command="{Binding AplicarEfeitosSelecionadosCommand}"
                  IsEnabled="{Binding !Ocupado}"
                  Background="#1A3A2A" Foreground="#00FF88"
                  CornerRadius="6" Padding="14,10"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  FontWeight="SemiBold"
                  Margin="0,6,0,0" />

        </StackPanel>
      </Border>

      <!-- ── Inicialização Automática ─────────────────────────────────────── -->
      <Border Background="#111111" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Inicialização Automática" Foreground="#CCCCCC"
                     FontWeight="SemiBold" />

          <ItemsControl ItemsSource="{Binding EntradasStartup}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InicializacaoEntradaViewModel">
                <Border Background="#0A0A0A" CornerRadius="6" Padding="12,8" Margin="0,2">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding Nome}" Foreground="#CCCCCC" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Caminho}" Foreground="#555555" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Impacto}"
                               Foreground="{Binding CorImpacto}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                    <ToggleButton Grid.Column="2" IsChecked="{Binding Ativo}"
                                  Foreground="#888888" FontSize="11"
                                  Content="{Binding Ativo, StringFormat={}{0:Ativo;0;Inativo}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Status -->
      <TextBlock Text="{Binding StatusOtimizador}" Foreground="#555555" FontSize="12" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
