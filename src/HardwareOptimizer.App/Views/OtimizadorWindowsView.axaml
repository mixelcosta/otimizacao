<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareOptimizer.App.ViewModels"
             x:Class="HardwareOptimizer.App.Views.OtimizadorWindowsView"
             x:DataType="vm:OtimizadorWindowsViewModel">

  <UserControl.Styles>
    <Style Selector="Border.efeito-item">
      <Setter Property="Background" Value="#0D0D0D" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="16">

      <TextBlock Text="OTIMIZADOR WINDOWS" FontSize="13" FontWeight="Bold"
                 Foreground="#444444" LetterSpacing="3" />

      <!-- Efeitos Visuais -->
      <Border Background="#111111" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Efeitos Visuais" Foreground="#CCCCCC" FontWeight="SemiBold" />
              <TextBlock Foreground="#555555" FontSize="11" Margin="0,2,0,0"
                         Text="VisualFXSetting → Melhor Desempenho (registro HKCU)" />
            </StackPanel>
            <Border Grid.Column="1" Background="#1A1A1A" CornerRadius="4"
                    Padding="8,4" VerticalAlignment="Center"
                    IsVisible="{Binding EfeitosVisuaisDesativados}">
              <TextBlock Text="✓ aplicado" Foreground="#00FF88" FontSize="11" />
            </Border>
          </Grid>

          <!-- Lista do que será desativado -->
          <TextBlock Text="SERÁ DESATIVADO:" Foreground="#444444"
                     FontSize="10" FontWeight="Bold" LetterSpacing="2"
                     Margin="0,4,0,2" />

          <Border Classes="efeito-item">
            <Grid ColumnDefinitions="18,*">
              <TextBlock Text="✕" Foreground="#FF4444" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Animações ao minimizar e maximizar janelas"
                         Foreground="#AAAAAA" FontSize="12" />
            </Grid>
          </Border>

          <Border Classes="efeito-item">
            <Grid ColumnDefinitions="18,*">
              <TextBlock Text="✕" Foreground="#FF4444" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Animações na barra de tarefas e área de notificação"
                         Foreground="#AAAAAA" FontSize="12" />
            </Grid>
          </Border>

          <Border Classes="efeito-item">
            <Grid ColumnDefinitions="18,*">
              <TextBlock Text="✕" Foreground="#FF4444" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Transparência e vidro (Aero / DWM compositing)"
                         Foreground="#AAAAAA" FontSize="12" />
            </Grid>
          </Border>

          <Border Classes="efeito-item">
            <Grid ColumnDefinitions="18,*">
              <TextBlock Text="✕" Foreground="#FF4444" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Sombras sob janelas e cursor do mouse"
                         Foreground="#AAAAAA" FontSize="12" />
            </Grid>
          </Border>

          <Border Classes="efeito-item">
            <Grid ColumnDefinitions="18,*">
              <TextBlock Text="✕" Foreground="#FF4444" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Mostrar conteúdo das janelas ao arrastar"
                         Foreground="#AAAAAA" FontSize="12" />
            </Grid>
          </Border>

          <Border Classes="efeito-item">
            <Grid ColumnDefinitions="18,*">
              <TextBlock Text="✕" Foreground="#FF4444" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Efeito Peek — pré-visualização na área de trabalho"
                         Foreground="#AAAAAA" FontSize="12" />
            </Grid>
          </Border>

          <Border Classes="efeito-item">
            <Grid ColumnDefinitions="18,*">
              <TextBlock Text="✕" Foreground="#FF4444" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Fade e deslizamento de menus e dicas de ferramenta"
                         Foreground="#AAAAAA" FontSize="12" />
            </Grid>
          </Border>

          <Border Classes="efeito-item">
            <Grid ColumnDefinitions="18,*">
              <TextBlock Text="✕" Foreground="#FF4444" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Miniaturas de janelas na barra de tarefas (Aero Snap)"
                         Foreground="#AAAAAA" FontSize="12" />
            </Grid>
          </Border>

          <Border Classes="efeito-item">
            <Grid ColumnDefinitions="18,*">
              <TextBlock Text="✕" Foreground="#FF4444" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Suavização de bordas de fontes de tela (ClearType sub-pixel)"
                         Foreground="#AAAAAA" FontSize="12" />
            </Grid>
          </Border>

          <Button Content="Desativar efeitos visuais"
                  Command="{Binding DesativarEfeitosVisuaisCommand}"
                  IsEnabled="{Binding !Ocupado}"
                  Background="#1A3A2A" Foreground="#00FF88"
                  CornerRadius="6" Padding="12,8"
                  Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <!-- Startup Scanner -->
      <Border Background="#111111" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Inicialização Automática" Foreground="#CCCCCC"
                     FontWeight="SemiBold" />

          <ItemsControl ItemsSource="{Binding EntradasStartup}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InicializacaoEntradaViewModel">
                <Border Background="#0A0A0A" CornerRadius="6" Padding="12,8" Margin="0,2">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding Nome}" Foreground="#CCCCCC" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Caminho}" Foreground="#555555" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Impacto}"
                               Foreground="{Binding CorImpacto}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                    <ToggleButton Grid.Column="2" IsChecked="{Binding Ativo}"
                                  Foreground="#888888" FontSize="11"
                                  Content="{Binding Ativo, StringFormat={}{0:Ativo;0;Inativo}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Status -->
      <TextBlock Text="{Binding StatusOtimizador}" Foreground="#555555" FontSize="12" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
