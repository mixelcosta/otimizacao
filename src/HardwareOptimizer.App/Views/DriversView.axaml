<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareOptimizer.App.ViewModels"
             x:Class="HardwareOptimizer.App.Views.DriversView"
             x:DataType="vm:DriversViewModel">

  <UserControl.Styles>
    <Style Selector="Button.varrer">
      <Setter Property="Background" Value="#1A1A2A" />
      <Setter Property="Foreground" Value="#00BFFF" />
      <Setter Property="BorderBrush" Value="#00BFFF40" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="20,9" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.varrer:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#222238" />
    </Style>
    <Style Selector="Button.varrer:disabled">
      <Setter Property="Foreground" Value="#334455" />
      <Setter Property="BorderBrush" Value="#223344" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Cabeçalho -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,0">
      <StackPanel Spacing="3">
        <TextBlock Text="DRIVERS" FontSize="13" FontWeight="Bold"
                   Foreground="#444444" LetterSpacing="3" />
        <TextBlock Text="Dispositivos instalados detectados via WMI (Win32_PnPSignedDriver)"
                   Foreground="#555555" FontSize="12" />
      </StackPanel>
      <Button Grid.Column="1" Classes="varrer"
              Command="{Binding VarrerCommand}"
              IsEnabled="{Binding !Ocupado}"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="💾" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="Varrer Dispositivos" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Conteúdo -->
    <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
      <StackPanel Margin="24,0,24,24" Spacing="10">

        <!-- Estado inicial / vazio -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="14" Margin="0,60"
                    IsVisible="{Binding !TemResultados}">
          <TextBlock Text="💾" FontSize="44" HorizontalAlignment="Center"
                     Foreground="#1A1A1A" />
          <TextBlock Text="{Binding StatusText}"
                     Foreground="#444444" FontSize="13"
                     HorizontalAlignment="Center" TextAlignment="Center"
                     TextWrapping="Wrap" MaxWidth="400" />
        </StackPanel>

        <!-- Cabeçalho da tabela (visível com resultados) -->
        <Grid ColumnDefinitions="*,140,120,80"
              Margin="4,0" IsVisible="{Binding TemResultados}">
          <TextBlock Grid.Column="0" Text="DISPOSITIVO" FontSize="10" FontWeight="Bold"
                     Foreground="#333333" LetterSpacing="1" />
          <TextBlock Grid.Column="1" Text="FABRICANTE" FontSize="10" FontWeight="Bold"
                     Foreground="#333333" LetterSpacing="1" />
          <TextBlock Grid.Column="2" Text="VERSÃO" FontSize="10" FontWeight="Bold"
                     Foreground="#333333" LetterSpacing="1" />
          <TextBlock Grid.Column="3" Text="STATUS" FontSize="10" FontWeight="Bold"
                     Foreground="#333333" LetterSpacing="1"
                     HorizontalAlignment="Right" />
        </Grid>

        <!-- Lista de drivers -->
        <ItemsControl ItemsSource="{Binding Drivers}"
                      IsVisible="{Binding TemResultados}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InfoDriverViewModel">

              <Border Background="#0D0D0D" CornerRadius="8"
                      BorderBrush="#191919" BorderThickness="1"
                      Padding="14,10" Margin="0,0,0,2">
                <Grid ColumnDefinitions="*,140,120,80">

                  <!-- Dispositivo + HWID -->
                  <StackPanel Grid.Column="0" Spacing="2"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Descricao}"
                               Foreground="#CCCCCC" FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding HwidCurto}"
                               Foreground="#333333" FontSize="10"
                               FontFamily="Consolas,Courier New,monospace"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <!-- Fabricante -->
                  <TextBlock Grid.Column="1"
                             Text="{Binding Fabricante}"
                             Foreground="#666666" FontSize="12"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />

                  <!-- Versão -->
                  <TextBlock Grid.Column="2"
                             Text="{Binding VersaoAtual}"
                             Foreground="#555555" FontSize="11"
                             FontFamily="Consolas,Courier New,monospace"
                             VerticalAlignment="Center" />

                  <!-- Badge de status -->
                  <Border Grid.Column="3"
                          Background="{Binding CorFundo}"
                          CornerRadius="4" Padding="8,3"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTexto}"
                               Foreground="{Binding CorStatus}"
                               FontSize="10" FontWeight="Bold"
                               LetterSpacing="0.5" />
                  </Border>

                </Grid>
              </Border>

            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Nota informativa sobre WHQL (visível com resultados) -->
        <Border Background="#0D0D0D" CornerRadius="8" Padding="14,10"
                IsVisible="{Binding TemResultados}"
                BorderBrush="#1C1C1C" BorderThickness="1">
          <TextBlock TextWrapping="Wrap" Foreground="#333333" FontSize="11">
            <Run Text="ℹ " Foreground="#2A2A2A" />
            <Run Text="Verificação WHQL online não está disponível nesta versão. Os status exibidos refletem apenas dados locais do sistema." />
          </TextBlock>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Rodapé -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16"
                Margin="24,0,24,16" IsVisible="{Binding TemResultados}">
      <TextBlock Text="{Binding StatusText}"
                 Foreground="#444444" FontSize="11"
                 VerticalAlignment="Center" />
      <TextBlock Text="{Binding UltimoScan}"
                 Foreground="#2A2A2A" FontSize="11"
                 VerticalAlignment="Center" />
    </StackPanel>

  </Grid>
</UserControl>
