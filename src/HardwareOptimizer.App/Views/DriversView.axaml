<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareOptimizer.App.ViewModels"
             x:Class="HardwareOptimizer.App.Views.DriversView"
             x:DataType="vm:DriversViewModel">

  <Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">

      <TextBlock Text="💾" FontSize="48" HorizontalAlignment="Center" />

      <TextBlock Text="DRIVERS" FontSize="22" FontWeight="Black"
                 Foreground="#FFFFFF" HorizontalAlignment="Center"
                 LetterSpacing="4" />

      <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Foreground="#555555"
                 FontSize="13" TextWrapping="Wrap" MaxWidth="380">
        Coleta de Hardware IDs (HWID), verificação de drivers WHQL atualizados
        e instalação silenciosa via pnputil com rollback automático.
      </TextBlock>

      <Border Background="#0D0D0D" CornerRadius="8" Padding="14,8"
              HorizontalAlignment="Center">
        <TextBlock Text="EM DESENVOLVIMENTO" Foreground="#FF8C00"
                   FontSize="11" FontWeight="Bold" LetterSpacing="2" />
      </Border>

    </StackPanel>
  </Grid>
</UserControl>
