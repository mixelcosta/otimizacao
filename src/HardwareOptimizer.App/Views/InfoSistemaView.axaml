<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareOptimizer.App.ViewModels"
             x:Class="HardwareOptimizer.App.Views.InfoSistemaView"
             x:DataType="vm:InfoSistemaViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">

      <!-- Cabeçalho -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="INFORMAÇÕES DO SISTEMA" FontSize="13" FontWeight="Bold"
                   Foreground="#444444" LetterSpacing="3"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="  Detectar  "
                Command="{Binding CarregarCommand}"
                IsEnabled="{Binding !Carregando}"
                Background="#1A1A1A" Foreground="#00FF88"
                BorderBrush="#00FF8840" BorderThickness="1"
                Padding="14,6" CornerRadius="6" FontSize="12" />
      </Grid>

      <!-- Erro -->
      <Border Background="#3D0000" CornerRadius="8" Padding="12,8"
              IsVisible="{Binding Erro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Erro}" Foreground="#FF6666" FontSize="12" />
      </Border>

      <!-- ═══ PLACA-MÃE ═══ -->
      <Border Background="#0D0D0D" CornerRadius="10" Padding="20">
        <StackPanel Spacing="10">

          <TextBlock Text="PLACA-MÃE" FontSize="10" FontWeight="Bold"
                     Foreground="#555555" LetterSpacing="2" />
          <Rectangle Height="1" Fill="#1A1A1A" />

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Fabricante" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Fabricante}"
                       Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Modelo" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Modelo}"
                       Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Bus Specs" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding BusSpecs}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Chipset" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Chipset}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

        </StackPanel>
      </Border>

      <!-- ═══ BIOS ═══ -->
      <Border Background="#0D0D0D" CornerRadius="10" Padding="20">
        <StackPanel Spacing="10">

          <TextBlock Text="BIOS" FontSize="10" FontWeight="Bold"
                     Foreground="#555555" LetterSpacing="2" />
          <Rectangle Height="1" Fill="#1A1A1A" />

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Fabricante" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding FabricanteBios}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Versão" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding VersaoBios}"
                       Foreground="#00FF88" FontSize="12" FontWeight="SemiBold" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Data" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding DataBios}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Modo" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ModoBios}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

        </StackPanel>
      </Border>

      <!-- ═══ INTERFACE GRÁFICA ═══ -->
      <Border Background="#0D0D0D" CornerRadius="10" Padding="20">
        <StackPanel Spacing="10">

          <TextBlock Text="INTERFACE GRÁFICA" FontSize="10" FontWeight="Bold"
                     Foreground="#555555" LetterSpacing="2" />
          <Rectangle Height="1" Fill="#1A1A1A" />

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="GPU" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding NomeGpu}"
                       Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Bus" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="PCI-Express"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <!-- Link Width -->
          <Grid ColumnDefinitions="160,80,140,*">
            <TextBlock Text="Current Link Width" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding LinkWidthAtual}"
                       Foreground="#00FF88" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Max. Supported" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding LinkWidthMax}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <!-- Link Speed -->
          <Grid ColumnDefinitions="160,80,140,*">
            <TextBlock Text="Current Link Speed" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding LinkSpeedAtual}"
                       Foreground="#00FF88" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Max. Supported" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding LinkSpeedMax}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
