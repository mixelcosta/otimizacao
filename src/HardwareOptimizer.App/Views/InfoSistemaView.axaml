<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HardwareOptimizer.App.ViewModels"
             x:Class="HardwareOptimizer.App.Views.InfoSistemaView"
             x:DataType="vm:InfoSistemaViewModel">

  <Grid>
    <!-- Estado vazio: aguardando SCAN NOW -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="10" IsVisible="{Binding !ComDados}">
      <TextBlock Text="–" FontSize="32" Foreground="#2A2A2A"
                 HorizontalAlignment="Center" />
      <TextBlock Text="Execute o SCAN NOW na tela inicial"
                 Foreground="#2A2A2A" FontSize="12"
                 HorizontalAlignment="Center" />
      <TextBlock Text="para carregar as informações do sistema"
                 Foreground="#222222" FontSize="11"
                 HorizontalAlignment="Center" />
    </StackPanel>

  <ScrollViewer IsVisible="{Binding ComDados}">
    <StackPanel Margin="24" Spacing="16">

      <!-- Cabeçalho -->
      <TextBlock Text="INFORMAÇÕES DO SISTEMA" FontSize="13" FontWeight="Bold"
                 Foreground="#444444" LetterSpacing="3" />

      <!-- ═══ SISTEMA OPERACIONAL ═══ -->
      <Border Background="#0D0D0D" CornerRadius="10" Padding="20">
        <StackPanel Spacing="10">

          <TextBlock Text="SISTEMA OPERACIONAL" FontSize="10" FontWeight="Bold"
                     Foreground="#555555" LetterSpacing="2" />
          <Rectangle Height="1" Fill="#1A1A1A" />

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Nome" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding NomeOs}"
                       Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
          </Grid>

          <Grid ColumnDefinitions="160,180,120,*">
            <TextBlock Text="Versão" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding VersaoOs}"
                       Foreground="#AAAAAA" FontSize="12" />
            <TextBlock Grid.Column="2" Text="Arquitetura" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding ArquiteturaOs}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

        </StackPanel>
      </Border>

      <!-- ═══ PROCESSADOR ═══ -->
      <Border Background="#0D0D0D" CornerRadius="10" Padding="20">
        <StackPanel Spacing="10">

          <TextBlock Text="PROCESSADOR" FontSize="10" FontWeight="Bold"
                     Foreground="#555555" LetterSpacing="2" />
          <Rectangle Height="1" Fill="#1A1A1A" />

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Nome" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding NomeCpu}"
                       Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
          </Grid>

          <Grid ColumnDefinitions="160,180,120,*">
            <TextBlock Text="Fabricante" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding FabricanteCpu}"
                       Foreground="#AAAAAA" FontSize="12" />
            <TextBlock Grid.Column="2" Text="Soquete" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding SoqueteCpu}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Núcleos / Threads" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding NucleosCpu}"
                       Foreground="#00FF88" FontSize="12" FontWeight="SemiBold" />
          </Grid>

          <Grid ColumnDefinitions="160,80,140,*">
            <TextBlock Text="Clock Base" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ClockBaseCpu}"
                       Foreground="#00FF88" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Clock Atual" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding ClockAtualCpu}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,80,140,*">
            <TextBlock Text="Cache L2" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding CacheL2Cpu}"
                       Foreground="#AAAAAA" FontSize="12" />
            <TextBlock Grid.Column="2" Text="Cache L3" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding CacheL3Cpu}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Temp. Idle" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding TempIdleCpu}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

        </StackPanel>
      </Border>

      <!-- ═══ PLACA-MÃE ═══ -->
      <Border Background="#0D0D0D" CornerRadius="10" Padding="20">
        <StackPanel Spacing="10">

          <TextBlock Text="PLACA-MÃE" FontSize="10" FontWeight="Bold"
                     Foreground="#555555" LetterSpacing="2" />
          <Rectangle Height="1" Fill="#1A1A1A" />

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Fabricante" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Fabricante}"
                       Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Modelo" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Modelo}"
                       Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
          </Grid>

          <Grid ColumnDefinitions="160,180,120,*">
            <TextBlock Text="Chipset" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Chipset}"
                       Foreground="#AAAAAA" FontSize="12" />
            <TextBlock Grid.Column="2" Text="Bus Specs" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding BusSpecs}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Secure Boot" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding SecureBoot}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

        </StackPanel>
      </Border>

      <!-- ═══ BIOS ═══ -->
      <Border Background="#0D0D0D" CornerRadius="10" Padding="20">
        <StackPanel Spacing="10">

          <TextBlock Text="BIOS" FontSize="10" FontWeight="Bold"
                     Foreground="#555555" LetterSpacing="2" />
          <Rectangle Height="1" Fill="#1A1A1A" />

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Fabricante" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding FabricanteBios}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,180,120,*">
            <TextBlock Text="Versão" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding VersaoBios}"
                       Foreground="#00FF88" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Data" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding DataBios}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Modo" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ModoBios}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

        </StackPanel>
      </Border>

      <!-- ═══ MEMÓRIA RAM ═══ -->
      <Border Background="#0D0D0D" CornerRadius="10" Padding="20">
        <StackPanel Spacing="10">

          <TextBlock Text="MEMÓRIA RAM" FontSize="10" FontWeight="Bold"
                     Foreground="#555555" LetterSpacing="2" />
          <Rectangle Height="1" Fill="#1A1A1A" />

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Total" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ResumoRam}"
                       Foreground="#00FF88" FontSize="12" FontWeight="SemiBold" />
          </Grid>

          <!-- Cabeçalho da tabela por slot -->
          <Grid ColumnDefinitions="80,60,90,100,140,60,50"
                Margin="0,6,0,2">
            <TextBlock Text="Slot"       Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="1" Text="Tam."       Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="2" Text="Tipo/Vel."  Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="3" Text="Fabricante" Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="4" Text="Modelo"     Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="5" Text="Form"       Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="6" Text="Tensão"     Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
          </Grid>
          <Rectangle Height="1" Fill="#1A1A1A" />

          <ItemsControl ItemsSource="{Binding SlotsRam}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SlotRamVm">
                <Grid ColumnDefinitions="80,60,90,100,140,60,50" Margin="0,4,0,0">
                  <TextBlock Text="{Binding Slot}"       Foreground="#AAAAAA" FontSize="11" />
                  <TextBlock Grid.Column="1" Text="{Binding Tamanho}"    Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="{Binding TipoVel}"    Foreground="#00FF88" FontSize="11" />
                  <TextBlock Grid.Column="3" Text="{Binding Fabricante}" Foreground="#AAAAAA" FontSize="11" />
                  <TextBlock Grid.Column="4" Text="{Binding Modelo}"     Foreground="#666666" FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="5" Text="{Binding FormFactor}" Foreground="#555555" FontSize="11" />
                  <TextBlock Grid.Column="6" Text="{Binding Tensao}"     Foreground="#555555" FontSize="11" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </Border>

      <!-- ═══ PLACA DE VÍDEO ═══ -->
      <Border Background="#0D0D0D" CornerRadius="10" Padding="20">
        <StackPanel Spacing="10">

          <TextBlock Text="PLACA DE VÍDEO" FontSize="10" FontWeight="Bold"
                     Foreground="#555555" LetterSpacing="2" />
          <Rectangle Height="1" Fill="#1A1A1A" />

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Nome" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding NomeGpu}"
                       Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
          </Grid>

          <Grid ColumnDefinitions="160,80,140,*">
            <TextBlock Text="VRAM" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding VramGpu}"
                       Foreground="#00FF88" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Bus" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="PCI-Express"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,80,140,*">
            <TextBlock Text="Resolução" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ResolucaoGpu}"
                       Foreground="#AAAAAA" FontSize="12" />
            <TextBlock Grid.Column="2" Text="Taxa" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding TaxaGpu}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,180,120,*">
            <TextBlock Text="Driver" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding DriverGpu}"
                       Foreground="#AAAAAA" FontSize="12" />
            <TextBlock Grid.Column="2" Text="Data do Driver" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding DataDriverGpu}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,*">
            <TextBlock Text="Temp. Idle" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding TempIdleGpu}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Rectangle Height="1" Fill="#1A1A1A" Margin="0,4,0,0" />

          <Grid ColumnDefinitions="160,80,140,*">
            <TextBlock Text="Current Link Width" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding LinkWidthAtual}"
                       Foreground="#00FF88" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Max. Supported" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding LinkWidthMax}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

          <Grid ColumnDefinitions="160,80,140,*">
            <TextBlock Text="Current Link Speed" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding LinkSpeedAtual}"
                       Foreground="#00FF88" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Max. Supported" Foreground="#555555" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding LinkSpeedMax}"
                       Foreground="#AAAAAA" FontSize="12" />
          </Grid>

        </StackPanel>
      </Border>

      <!-- ═══ ARMAZENAMENTO ═══ -->
      <Border Background="#0D0D0D" CornerRadius="10" Padding="20"
              IsVisible="{Binding TemDiscos}">
        <StackPanel Spacing="10">

          <TextBlock Text="ARMAZENAMENTO" FontSize="10" FontWeight="Bold"
                     Foreground="#555555" LetterSpacing="2" />
          <Rectangle Height="1" Fill="#1A1A1A" />

          <!-- Cabeçalho -->
          <Grid ColumnDefinitions="60,100,100,100,70" Margin="0,4,0,2">
            <TextBlock Text="Drive"   Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="1" Text="Total"  Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="2" Text="Usado"  Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="3" Text="Livre"  Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="4" Text="Uso %"  Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
          </Grid>
          <Rectangle Height="1" Fill="#1A1A1A" />

          <ItemsControl ItemsSource="{Binding DiscosSistema}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DadosDiscoVm">
                <Grid ColumnDefinitions="60,100,100,100,70" Margin="0,4,0,0">
                  <TextBlock Text="{Binding Letra}"      Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Total}"      Foreground="#AAAAAA" FontSize="11" />
                  <TextBlock Grid.Column="2" Text="{Binding Usado}"      Foreground="#AAAAAA" FontSize="11" />
                  <TextBlock Grid.Column="3" Text="{Binding Livre}"      Foreground="#AAAAAA" FontSize="11" />
                  <TextBlock Grid.Column="4" Text="{Binding UsoPercent}"
                             Foreground="{Binding CorUso}" FontSize="11" FontWeight="SemiBold" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </Border>

      <!-- ═══ SAÚDE DOS DISCOS (S.M.A.R.T.) ═══ -->
      <Border Background="#0D0D0D" CornerRadius="10" Padding="20"
              IsVisible="{Binding TemSaudeDiscos}">
        <StackPanel Spacing="10">

          <TextBlock Text="SAÚDE DOS DISCOS  ·  S.M.A.R.T." FontSize="10" FontWeight="Bold"
                     Foreground="#555555" LetterSpacing="2" />
          <Rectangle Height="1" Fill="#1A1A1A" />

          <!-- Cabeçalho -->
          <Grid ColumnDefinitions="2*,50,70,80,80,70,60,60" Margin="0,4,0,2">
            <TextBlock Text="Modelo"         Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="1" Text="Drive"          Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="2" Text="Status"         Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="3" Text="Vida rest."     Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="4" Text="Horas uso"      Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="5" Text="TBW escrito"    Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="6" Text="Erros"          Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="7" Text="Setores"        Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
          </Grid>
          <Rectangle Height="1" Fill="#1A1A1A" />

          <ItemsControl ItemsSource="{Binding SaudeDiscosSmart}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SaudeDiscoVm">
                <Grid ColumnDefinitions="2*,50,70,80,80,70,60,60" Margin="0,5,0,0">
                  <TextBlock Text="{Binding Modelo}"       Foreground="#AAAAAA" FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Letra}"        Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="{Binding Status}"       Foreground="{Binding CorStatus}" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="3" Text="{Binding VidaRestante}" Foreground="#AAAAAA" FontSize="11" />
                  <TextBlock Grid.Column="4" Text="{Binding HorasUso}"     Foreground="#AAAAAA" FontSize="11" />
                  <TextBlock Grid.Column="5" Text="{Binding TbwEscrito}"   Foreground="#AAAAAA" FontSize="11" />
                  <TextBlock Grid.Column="6" Text="{Binding Erros}"        Foreground="{Binding CorErros}" FontSize="11" />
                  <TextBlock Grid.Column="7" Text="{Binding Setores}"      Foreground="#555555" FontSize="11" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </Border>

      <!-- ═══ REDE ═══ -->
      <Border Background="#0D0D0D" CornerRadius="10" Padding="20"
              IsVisible="{Binding TemRede}">
        <StackPanel Spacing="10">

          <TextBlock Text="INTERFACES DE REDE" FontSize="10" FontWeight="Bold"
                     Foreground="#555555" LetterSpacing="2" />
          <Rectangle Height="1" Fill="#1A1A1A" />

          <!-- Cabeçalho -->
          <Grid ColumnDefinitions="2*,120,*" Margin="0,4,0,2">
            <TextBlock Text="Nome"        Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="1" Text="Tipo"        Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
            <TextBlock Grid.Column="2" Text="MAC"         Foreground="#3A3A3A" FontSize="10" LetterSpacing="1" />
          </Grid>
          <Rectangle Height="1" Fill="#1A1A1A" />

          <ItemsControl ItemsSource="{Binding InterfacesRede}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InterfaceRedeVm">
                <Grid ColumnDefinitions="2*,120,*" Margin="0,4,0,0">
                  <TextBlock Text="{Binding Nome}" Foreground="#AAAAAA" FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Tipo}" Foreground="#AAAAAA" FontSize="11" />
                  <TextBlock Grid.Column="2" Text="{Binding Mac}"  Foreground="#444444" FontSize="11" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

  </Grid>
</UserControl>
